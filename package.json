{
  "name": "deal-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI executive coaching prototype \u2014 two-track (deal tactics + mindset) advisor.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cross-env API_PORT=3001 node --watch server/index.js",
    "dev:web": "cross-env API_PORT=3001 vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "preview": "npm run build && npm start",
    "voices": "node scripts/list-voices.js",
    "check:demo-figures": "node scripts/check-demo-figures.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "vite": "^7.1.9"
  }
}
