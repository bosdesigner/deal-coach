# Copy to .env for local dev. On Replit use the Secrets pane instead —
# a .env file in the workspace is visible to anyone you invite to the Repl.
#
# .env is gitignored. Never commit a real key.

# Required. Server-side only — never exposed to the browser.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Port for the Express API in dev. Replit sets this via .replit.
# API_PORT=3001

# Optional. Port for the Vite dev server. Defaults to 5173.
# VITE_PORT=5173

# ---- Voice (optional) ----------------------------------------------------
# Without these the app runs fine and the voice toggle reads UNAVAILABLE.
# NEVER configure a voice that clones or imitates a real public figure —
# see docs/voice-setup.md for why that is blocked three ways over.

# ELEVENLABS_API_KEY=...
# Run `npm run voices` to list ids on your account. Avoid 'premade' voices:
# ElevenLabs' default voices expire 2026-12-31.
# ELEVENLABS_VOICE_ID=...
# ELEVENLABS_MODEL=eleven_flash_v2_5
